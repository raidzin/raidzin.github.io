---
import { getCollection, render } from "astro:content";

interface Props {
  color?: string;
  backgroundColor?: string;
}

const { color = "primary", backgroundColor = "base-200" } = Astro.props;

const entries = await getCollection("techStack");

const sortedEntries = entries.sort((a, b) => a.data.order - b.data.order);

// Render markdown content for each entry
const entriesWithContent = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<section id="tech-stack" class={`py-20 px-4 bg-${backgroundColor}`}>
  <div class="mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold">Мой стек</h2>
    </div>
  </div>
  <div class="mx-auto max-w-2xl flex flex-col gap-2">
    {
      entriesWithContent.map(({ entry, Content }, index) => (
        <div class="collapse collapse-arrow bg-base-100 rounded-box shadow-lg">
          <input type="checkbox" name="techStack" />
          <div class="collapse-title flex flex-row items-center gap-4">
            {entry.data.logo && (
              <div class="w-16 mask mask-square">
                <img src={entry.data.logo} alt={entry.data.title} />
              </div>
            )}
            <div>
              <h3 class="font-bold text-3xl">{entry.data.title}</h3>
              <p class={`text-${color} font-semibold text-lg`}>
                {entry.data.experience}
              </p>
            </div>
          </div>
          <div class="collapse-content text-sm">
            <div class="prose prose-sm max-w-none text-base-content/80">
              <Content />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
