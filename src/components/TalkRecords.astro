---
import { Image } from "astro:assets";
import nnfrontend from "../assets/nnfrontend.jpg";

interface Props {
  color?: string;
  backgroundColor?: string;
}

const { color = "primary", backgroundColor = "base-200" } = Astro.props;
---

<section id="talk-records" class={`py-20 px-4 bg-${backgroundColor}`}>
  <div class="mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold">Мои доклады</h2>
    </div>
  </div>
  <div class="mx-auto w-full carousel md:justify-center gap-4">
    <div id="PyhtoNN" class="carousel-item w-full max-w-xl">
      <div class="card bg-base-100 shadow-sm w-full">
        <figure class="w-full aspect-video">
          <iframe
            src="https://www.youtube.com/embed/lN3Pz_hUCio?si=orHUj_Sldym08MQM"
            title="PythoNN 2025-04-04"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"></iframe>
        </figure>
        <div class="card-body gap-0">
          <div class="flex flex-row justify-between items-end">
            <h2 class="card-title font-bold">PythoNN</h2>
            <span class="text-secondary">04.04.2025</span>
          </div>
          <div class="divider my-0"></div>
          <p>
            <strong class="text-primary"
              >Современный web с современными темплейтами</strong
            >. Говорю про актуальные веб фреймворки и рассказываю чем мне
            нравится
            <strong>Litestar</strong> и как с помощью него и <strong
              >HTMX</strong
            > сделать динамичный web на шаблонах
          </p>
          <div class="card-actions justify-end">
            <a
              href="https://t.me/pytho_nn"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-circle btn-ghost btn-xs"
              aria-label="Telegram"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  d="M10,0 C15.5228475,0 20,4.4771525 20,10 C20,15.5228475 15.5228475,20 10,20 C4.4771525,20 0,15.5228475 0,10 C0,4.4771525 4.4771525,0 10,0 Z M14.4415206,6 C14.060553,6.00676048 13.476055,6.20741135 10.663148,7.36249773 C9.67796175,7.7670526 7.70897661,8.60437935 4.75619264,9.87447795 C4.27670659,10.0627254 4.02553067,10.2468857 4.00266485,10.4269588 C3.95876487,10.7726802 4.46291296,10.8803081 5.09723696,11.0838761 C5.61440201,11.2498453 6.31007997,11.4440124 6.67173438,11.4517262 C6.99978943,11.4587234 7.36593635,11.3251987 7.77017511,11.051152 C10.5290529,9.21254679 11.9531977,8.28322679 12.0426094,8.26319203 C12.1056879,8.24905787 12.1930992,8.23128593 12.2523244,8.28325656 C12.3115496,8.33522719 12.3057275,8.43364956 12.299454,8.46005377 C12.2492926,8.67117474 9.65764825,10.998457 9.50849738,11.1513987 L9.43697409,11.2233057 C8.88741493,11.7661123 8.33196049,12.1205055 9.290333,12.7440164 C10.155665,13.3069957 10.6592923,13.6661378 11.5507686,14.2430701 C12.1204738,14.6117635 12.5671299,15.0489784 13.1553348,14.9955401 C13.4259939,14.9709508 13.705567,14.7196888 13.8475521,13.9703127 C14.1831052,12.1993135 14.8426779,8.36209709 14.9951103,6.78087197 C15.0084653,6.64233621 14.9916649,6.46503787 14.9781732,6.38720805 C14.9646815,6.30937823 14.9364876,6.19848702 14.8340164,6.11639754 C14.7126597,6.01917896 14.5253109,5.99867765 14.4415206,6 Z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div id="NNFrontend" class="carousel-item w-full max-w-xl">
      <div class="card bg-base-100 shadow-sm w-full">
        <figure class="w-full aspect-video">
          <Image src={nnfrontend} alt="NNFrontend header" />
        </figure>
        <div class="card-body gap-0">
          <div class="flex flex-row justify-between items-end">
            <h2 class="card-title font-bold">NNFrontend</h2>
            <span class="text-secondary">26.11.2025</span>
          </div>
          <div class="divider my-0"></div>
          <p>
            <strong class="text-primary">Технологии древних</strong>. Говорим
            про <strong>Gleam</strong>, как на нём делать фронтенд, чем он лучше
            TypeScript, какая крутая виртуальная машина в Erlang и при чём тут
            Rust
          </p>
          <div class="card-actions justify-end">
            <a
              href="https://t.me/NNFrontend"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-circle btn-ghost btn-xs"
              aria-label="Telegram"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  d="M10,0 C15.5228475,0 20,4.4771525 20,10 C20,15.5228475 15.5228475,20 10,20 C4.4771525,20 0,15.5228475 0,10 C0,4.4771525 4.4771525,0 10,0 Z M14.4415206,6 C14.060553,6.00676048 13.476055,6.20741135 10.663148,7.36249773 C9.67796175,7.7670526 7.70897661,8.60437935 4.75619264,9.87447795 C4.27670659,10.0627254 4.02553067,10.2468857 4.00266485,10.4269588 C3.95876487,10.7726802 4.46291296,10.8803081 5.09723696,11.0838761 C5.61440201,11.2498453 6.31007997,11.4440124 6.67173438,11.4517262 C6.99978943,11.4587234 7.36593635,11.3251987 7.77017511,11.051152 C10.5290529,9.21254679 11.9531977,8.28322679 12.0426094,8.26319203 C12.1056879,8.24905787 12.1930992,8.23128593 12.2523244,8.28325656 C12.3115496,8.33522719 12.3057275,8.43364956 12.299454,8.46005377 C12.2492926,8.67117474 9.65764825,10.998457 9.50849738,11.1513987 L9.43697409,11.2233057 C8.88741493,11.7661123 8.33196049,12.1205055 9.290333,12.7440164 C10.155665,13.3069957 10.6592923,13.6661378 11.5507686,14.2430701 C12.1204738,14.6117635 12.5671299,15.0489784 13.1553348,14.9955401 C13.4259939,14.9709508 13.705567,14.7196888 13.8475521,13.9703127 C14.1831052,12.1993135 14.8426779,8.36209709 14.9951103,6.78087197 C15.0084653,6.64233621 14.9916649,6.46503787 14.9781732,6.38720805 C14.9646815,6.30937823 14.9364876,6.19848702 14.8340164,6.11639754 C14.7126597,6.01917896 14.5253109,5.99867765 14.4415206,6 Z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="flex w-full justify-center gap-2 pt-4">
    <a href="#PyhtoNN" class="btn btn-outline btn-sm">1</a>
    <a href="#NNFrontend" class="btn btn-outline btn-sm">2</a>
  </div>
</section>
