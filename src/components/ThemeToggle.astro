---
// Theme toggle component for switching between silk and abyss modes
import { Lightbulb } from "@lucide/astro";
---

<label class="swap swap-flip">
  <input type="checkbox" class="theme-controller" value="abyss" />

  <Lightbulb class="swap-off fill-current w-6 h-6 rotate-180" />
  <Lightbulb class="swap-on w-6 h-6 rotate-180" />
</label>

<script is:inline>
  // Set theme on page load based on localStorage or system preference
  function setTheme() {
    const theme =
      localStorage.getItem("theme") ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "abyss"
        : "silk");
    document.documentElement.setAttribute("data-theme", theme);
    const toggle = document.querySelector(".theme-controller");
    if (toggle) {
      toggle.checked = theme === "abyss";
    }
  }

  // Update theme when toggle is clicked
  document.addEventListener("change", (e) => {
    const target = e.target;
    if (target.classList.contains("theme-controller")) {
      const theme = target.checked ? "abyss" : "silk";
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
    }
  });

  // Run on page load
  setTheme();

  // Run after view transitions
  document.addEventListener("astro:after-swap", setTheme);
</script>
