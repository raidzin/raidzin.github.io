---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import Blog from "../components/Blog.astro";
import Hackathons from "../components/Hackathons.astro";
import Contact from "../components/Contact.astro";
import TechStack from "../components/TechStack.astro";
import { Briefcase, GraduationCap } from "@lucide/astro";
import { getEntry, render } from "astro:content";
import { siteConfig } from "../config";
import avatar from "../assets/avatar.png";
import aboutPhoto from "../assets/about.jpg";

// Load about content
const aboutEntry = await getEntry("about", "about");
const { Content: AboutContent } = await render(aboutEntry);
---

<Layout title="Raidzin" description={siteConfig.description}>
  <main>
    <!-- Hero Section (Always visible) -->
    <Hero
      name="Алексей Гончарук"
      akas={["Raidzin"]}
      description="Фуллстек разработчик, немного опенсорсер и начинающий спикер"
      avatar={avatar}
      location={siteConfig.location}
      socialLinks={siteConfig.socialLinks}
    />

    <!-- About Section -->
    {
      siteConfig.sections.about && (
        <About
          title={aboutEntry.data.title}
          photo={aboutPhoto}
          Content={AboutContent}
        />
      )
    }

    <TechStack />

    <!-- Projects Section -->
    {siteConfig.sections.projects && <Projects />}

    <!-- Blog Section -->
    {siteConfig.sections.blog && <Blog />}

    <!-- Work Experience Section -->
    {
      siteConfig.sections.work && (
        <Timeline
          collection="work"
          variant="timeline"
          color="primary"
          backgroundColor="base-300"
          icon={Briefcase}
          sectionTitle="Опыт работы"
        />
      )
    }

    <!-- Education Section -->
    {
      siteConfig.sections.education && (
        <Timeline
          collection="education"
          variant="list"
          color="secondary"
          backgroundColor="base-300"
          icon={GraduationCap}
          sectionTitle="Education"
        />
      )
    }

    <!-- Hackathons Section -->
    {siteConfig.sections.hackathons && <Hackathons />}

    <!-- Contact Section -->
    {siteConfig.sections.contact && <Contact />}
  </main>
</Layout>
